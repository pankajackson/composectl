# Copy to .env and replace every placeholder before starting the stack.
# Generate secrets with: openssl rand -hex 32

# --- Core secrets ---
LITELLM_MASTER_KEY=sk-REPLACE_WITH_RANDOM_SECRET
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET
REDIS_PASSWORD=REPLACE_WITH_RANDOM_SECRET
WEBUI_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET

# --- Provider keys (leave blank to skip a provider) ---
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=

# --- Modules enabled by default (comma separated): comfy, tabby, voice ---
COMPOSE_PROFILES=

# --- General ---
TZ=Asia/Kolkata
DATA_DIR=./data

# --- Ollama VRAM behaviour ---
OLLAMA_KEEP_ALIVE=3m
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1

# --- Optional image pins (pin these once everything works) ---
# OLLAMA_TAG=latest
# LITELLM_TAG=main-stable
# COMFY_TAG=cu128-slim
# COMFY_ARGS=--lowvram
# TABBY_TAG=latest
