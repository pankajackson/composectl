# Copy to .env and fill in. Generate secrets with: openssl rand -hex 24

# --- Core secrets ---
LITELLM_MASTER_KEY=sk-change-me
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
WEBUI_SECRET_KEY=change-me

# --- Free provider keys (leave blank to skip a provider) ---
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=

# --- Modules enabled by default (comma separated): comfy, tabby, voice ---
COMPOSE_PROFILES=

# --- General ---
TZ=Asia/Kolkata
DATA_DIR=./data

# --- Ollama VRAM behaviour ---
OLLAMA_KEEP_ALIVE=3m
OLLAMA_MAX_LOADED_MODELS=2

# --- Optional image pins (pin these once everything works) ---
# OLLAMA_TAG=latest
# LITELLM_TAG=main-stable
# COMFY_TAG=cu128-slim
# COMFY_ARGS=--lowvram
# TABBY_TAG=latest
