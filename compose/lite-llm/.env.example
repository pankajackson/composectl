# Copy to .env and replace the secret values.
# Generate each secret with: openssl rand -hex 32
LITELLM_MASTER_KEY=sk-replace-with-a-random-secret
WEBUI_SECRET_KEY=replace-with-a-different-random-secret
POSTGRES_PASSWORD=replace-with-a-random-password

# Leave a provider key blank to disable that provider (and remove it from smart tiers).
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional local settings
DATA_DIR=./data
WEBUI_PORT=3000
LITELLM_PORT=4000
OLLAMA_PORT=11434
# OLLAMA_TAG=latest
# LITELLM_TAG=main-stable
# WEBUI_TAG=main
# Set to a model your machine can run, then pull it in Ollama.
# The default configured model is qwen3:8b.
