# Copy this file to .env and fill in real values before running
# `docker compose up -d`. Never commit the real .env to git.

# ---- Image (pick ONE based on where this runs) ----
# Linux server / NAS on amd64 (x86_64):
WAHA_IMAGE=devlikeapro/waha:latest
# MacBook (Apple Silicon: M1/M2/M3/M4) or any arm64 host — comment the
# line above and uncomment this one instead:
# WAHA_IMAGE=devlikeapro/waha:arm

# Generate with: openssl rand -hex 32
WAHA_API_KEY=changeme_generate_a_real_key

WAHA_DASHBOARD_USERNAME=admin
# Generate with: openssl rand -hex 16
WAHA_DASHBOARD_PASSWORD=changeme_generate_a_real_password

# Your n8n Webhook node's URL — WAHA POSTs incoming WhatsApp events here.
# Example: http://<n8n-host>:5678/webhook/whatsapp-incoming
N8N_WEBHOOK_URL=http://n8n:5678/webhook-test/waha-incoming
# N8N_WEBHOOK_URL=http://n8n:5678/webhook/waha-incoming
